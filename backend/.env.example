# =============================================================================
# Contoh Konfigurasi Lingkungan (Environment Configuration) - SAS SMK
# Salin file ini menjadi ".env" dan sesuaikan nilainya.
# =============================================================================

# Konfigurasi Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sas_db
DB_USER=root
DB_PASS=password_anda
DB_CHARSET=utf8mb4

# Konfigurasi Keamanan & Token
# GANTI STRING DI BAWAH INI DENGAN RANDOM STRING YANG PANJANG DI PRODUCTION!
TOKEN_SECRET=KetikRandomRahasiaAndaDisini
TOKEN_LIFETIME=28800
