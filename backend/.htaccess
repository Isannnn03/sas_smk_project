# ============================================================================
# SMART ATTENDANCE SYSTEM (SAS) - SMK
# File: backend/.htaccess
# Tujuan: Konfigurasi Apache untuk backend PHP Native
# ============================================================================

# Pastikan mod_rewrite aktif
Options -Indexes
Options +FollowSymLinks

# Tentukan urutan file index (Dashboard SPA prioritas utama)
<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

# Lindungi file konfigurasi dari akses langsung
<FilesMatch "^(database\.php|helpers\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# CORS & Caching untuk asset statis
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Aktifkan mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase "/sas smk project/sas_smk_project/backend/"

    # Pass Authorization header to PHP
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

    # Jangan rewrite untuk file/direktori yang benar-benar ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan semua request yang tidak cocok ke index.html untuk Vue Router (SPA)
    RewriteRule ^(.*)$ index.html [QSA,L]
</IfModule>
